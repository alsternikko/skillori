// Copy to Signing.local.xcconfig (not committed) to sign with your own Developer ID.
// Needed for scripts/notarize.sh. Find your team ID with: security find-identity -v -p codesigning

DEVELOPMENT_TEAM = XXXXXXXXXX
CODE_SIGN_IDENTITY = Developer ID Application
OTHER_CODE_SIGN_FLAGS = --timestamp

// If you distribute your own fork, give it its own bundle identifier.
